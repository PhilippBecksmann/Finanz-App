// Prisma schema for the Personal Finance & Portfolio App
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// A single income or expense entry (manual cashflow tracking).
// `type` is a plain string ('INCOME' | 'EXPENSE') because SQLite has no enums.
model Transaction {
  id          String   @id @default(cuid())
  amount      Float // always stored positive; sign is derived from `type`
  type        String // 'INCOME' | 'EXPENSE'
  category    String
  date        DateTime
  isRecurring Boolean  @default(false)
  note        String?
  createdAt   DateTime @default(now())
}

// A portfolio holding. Prices are fetched live via yahoo-finance2.
model Asset {
  id        String   @id @default(cuid())
  symbol    String
  shares    Float
  buyPrice  Float
  currency  String   @default("EUR")
  createdAt DateTime @default(now())
}
